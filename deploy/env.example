# Paste the model provider key only into the server's .env file; never commit it.
MODEL_API_KEY=
# Use the live Muse drafter for the hosted demo.
DRAFTER=muse
# 1 shows demo-only buttons that anyone with the link can press; use 1 only while judges need them.
DEMO_CONTROLS=1
# Maximum model spend allowed per UTC day, in US dollars.
DAILY_SPEND_CAP_USD=2.00
# Persistent SQLite database location inside the app container.
DB_PATH=/data/okayly.db
# Demo domain only; replace this placeholder with the new domain pointed at the server.
SITE_ADDRESS=demo.example
